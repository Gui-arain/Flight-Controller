	(text "I_limit = 500/R_ILIM\nHere we set I_limit = 2A\n---------------\nSitching logic:\nVSNS = V_IN1 * R7/(R6+R7)\nif VSNS > 0.8V => OUT = IN1\notherwise take the highest input\n---------------\nWe want:\nif V_IN1 > 5V => OUT = IN1"
		(exclude_from_sim no)
		(at 166.624 122.428 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "2cc94aa4-8a24-4915-bae3-8bbce34c4944")
	)
	(text "V_OUT set by R21 and R22:\nR21 = R22(V_OUT/0.8V - 1)"
